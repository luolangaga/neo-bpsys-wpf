<Page
    x:Class="Bpsys.Plugin.ASG.Views.Pages.AsgHelperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    d:DesignWidth="1100" d:DesignHeight="820">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="12">
            <ui:CardExpander ContentPadding="12">
                <ui:CardExpander.Header>
                    <TextBlock FontSize="16" FontWeight="Bold" Text="登录统一平台" />
                </ui:CardExpander.Header>
                <ui:CardExpander.Content>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="260" PlaceholderText="邮箱" Text="{Binding AsgEmail, Mode=TwoWay}" Margin="0,0,10,0" />
                            <ui:PasswordBox Width="200" PlaceholderText="密码" Password="{Binding AsgPassword, Mode=TwoWay}" Margin="0,0,10,0" />
                            <ui:Button Content="保存并登录" Icon="{ui:SymbolIcon Symbol=ArrowImport24}" Command="{Binding LoginCommand}" Margin="0,0,10,0" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoggingIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:ProgressRing Width="28" Height="28" IsIndeterminate="True" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="正在登录..." />
                            </StackPanel>
                        </StackPanel>
                        <ui:InfoBar Margin="0,8,0,0"
                                    Title="提示"
                                    Message="凭据仅保存在本地配置，登录失败时可重试或更换账号。"
                                    Severity="Informational" />
                    </StackPanel>
                </ui:CardExpander.Content>
            </ui:CardExpander>

            <ui:CardExpander ContentPadding="12">
                <ui:CardExpander.Header>
                    <TextBlock FontSize="16" FontWeight="Bold" Text="赛事与赛程" />
                </ui:CardExpander.Header>
                <ui:CardExpander.Content>
                    <StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox Width="320" PlaceholderText="搜索赛事关键词" Text="{Binding EventQuery, Mode=TwoWay}" Margin="0,0,10,0" />
                                <ui:Button Content="搜索赛事" Icon="{ui:SymbolIcon Symbol=Search24}" Command="{Binding SearchEventsCommand}" Margin="0,0,10,0" />
                                <ui:Button Content="加载赛程" Icon="{ui:SymbolIcon Symbol=ArrowSort24}" Command="{Binding LoadMatchesCommand}" Margin="0,0,10,0" />
                                <ui:Button Content="导入选中赛程两队信息" Icon="{ui:SymbolIcon Symbol=ArrowImport24}" Command="{Binding ImportSelectedMatchTeamsCommand}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="SemiBold" Text="赛事搜索结果" Margin="0,0,0,6" />
                                    <ListBox ItemsSource="{Binding EventResults}" SelectedItem="{Binding SelectedEvent}" DisplayMemberPath="Name" MinHeight="140" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="赛程列表" Margin="0,0,8,0" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsMatchResultsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ui:TextBox Width="60" PlaceholderText="页码" Text="{Binding MatchesPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                            <ui:TextBox Width="60" PlaceholderText="每页" Text="{Binding MatchesPageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                            <ui:Button Command="{Binding PrevMatchesPageCommand}" ToolTip="上一页" Margin="0,0,6,0">
                                                <ui:SymbolIcon Symbol="ArrowLeft24" />
                                            </ui:Button>
                                            <ui:Button Command="{Binding NextMatchesPageCommand}" ToolTip="下一页" Margin="0,0,6,0">
                                                <ui:SymbolIcon Symbol="ArrowRight24" />
                                            </ui:Button>
                                            <ui:Button Command="{Binding RefreshMatchesCommand}" ToolTip="刷新">
                                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding MatchResults}" SelectedItem="{Binding SelectedMatch}" MinHeight="140">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="主队：" />
                                                    <TextBlock Text="{Binding HomeTeamName}" />
                                                    <TextBlock Margin="10,0,0,0" Text="客队：" />
                                                    <TextBlock Text="{Binding AwayTeamName}" />
                                                    <TextBlock Margin="10,0,0,0" Text=" | 赛事：" />
                                                    <TextBlock Text="{Binding EventName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander.Content>
            </ui:CardExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
