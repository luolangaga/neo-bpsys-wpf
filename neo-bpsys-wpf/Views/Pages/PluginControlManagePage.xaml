<Page
    x:Class="neo_bpsys_wpf.Views.Pages.PluginControlManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:neo_bpsys_wpf.Views.Pages"
    xmlns:converters="clr-namespace:neo_bpsys_wpf.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:neo_bpsys_wpf.ViewModels.Pages"
    Title="插件控件管理"
    d:DataContext="{d:DesignInstance Type=vm:PluginControlManagePageViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="900"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
    </Page.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题和统计 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock 
                FontSize="24" 
                FontWeight="Bold" 
                Text="插件控件管理"/>
            <TextBlock 
                Margin="0,8,0,0" 
                FontSize="14" 
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                Text="管理插件提供的前台控件，控制它们的显示与隐藏"/>
        </StackPanel>

        <!-- 统计信息 -->
        <Border 
            Grid.Row="1" 
            Margin="0,0,0,16" 
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="20" Symbol="AppsList24"/>
                    <TextBlock VerticalAlignment="Center" Text="总控件数:" Margin="8,0,0,0"/>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" Text="{Binding TotalControlCount}" Margin="4,0,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="20" Symbol="Eye24" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    <TextBlock VerticalAlignment="Center" Text="已显示:" Margin="8,0,0,0"/>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding VisibleControlCount}" Margin="4,0,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="20" Symbol="EyeOff24" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock VerticalAlignment="Center" Text="已隐藏:" Margin="8,0,0,0"/>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding HiddenControlCount, Mode=OneWay}" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 操作按钮栏 -->
        <StackPanel 
            Grid.Row="2" 
            Margin="0,0,0,16" 
            Orientation="Horizontal">
            <ui:Button Content="刷新列表" Command="{Binding RefreshControlsCommand}" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"/>
            <ui:Button Content="全部显示" Command="{Binding ShowAllControlsCommand}" Icon="{ui:SymbolIcon Symbol=Eye24}" Margin="12,0,0,0"/>
            <ui:Button Content="全部隐藏" Command="{Binding HideAllControlsCommand}" Icon="{ui:SymbolIcon Symbol=EyeOff24}" Margin="12,0,0,0"/>
            <ui:Button Content="重置为默认" Command="{Binding ResetToDefaultCommand}" Icon="{ui:SymbolIcon Symbol=ArrowReset24}" Appearance="Secondary" Margin="12,0,0,0"/>
            <Separator Width="1" Margin="12,4,0,4"/>
            <ui:TextBox Width="250" PlaceholderText="搜索控件名称或插件..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Icon="{ui:SymbolIcon Symbol=Search24}" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 控件列表 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Controls}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border 
                            Style="{StaticResource Card}" 
                            Margin="0,0,0,12"
                            Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- 控件名称 -->
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                    
                                    <!-- 详细信息 -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon FontSize="14" Symbol="AppsAddIn24" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0">
                                                <Run Text="插件:"/>
                                                <Run Text="{Binding PluginName}" FontWeight="Medium"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,0">
                                                <Run Text="窗口:"/>
                                                <Run Text="{Binding TargetWindowName}" FontWeight="Medium"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,0">
                                                <Run Text="画布:"/>
                                                <Run Text="{Binding CanvasName}" FontWeight="Medium"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- 控件ID -->
                                    <TextBlock 
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding ControlId, StringFormat='ID: {0}'}"/>
                                </StackPanel>

                                <!-- 显示/隐藏开关 -->
                                <StackPanel 
                                    Grid.Column="1" 
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="{Binding IsVisible, Mode=OneWay, Converter={StaticResource BoolToTextConverter}}"/>
                                    <ui:ToggleSwitch IsChecked="{Binding IsVisible, Mode=TwoWay}" ToolTip="控制该控件是否在前台窗口显示" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
